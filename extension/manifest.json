{
  "manifest_version": 3,
  "name": "ContentIQ — Performance Dashboard",
  "version": "1.0.0",
  "description": "Social content performance analytics dashboard.",
  "permissions": ["storage"],
  "host_permissions": ["*://*.instagram.com/*"],
  "content_scripts": [
    {
      "matches": ["*://*.instagram.com/*"],
      "run_at": "document_start",
      "all_frames": false,
      "css": ["disguise.css"],
      "js": ["content.js"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ContentIQ"
  }
}
